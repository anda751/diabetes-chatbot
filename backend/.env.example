PORT=5000
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Required in production. Backend will not start in production without this value.
SESSION_SECRET=replace_with_a_unique_random_secret
SESSION_TTL_MS=604800000
# Required in production for push notifications.
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
REMINDER_TIMEZONE=Asia/Bangkok
# SESSION_COOKIE_SAME_SITE=Lax
# SESSION_COOKIE_SECURE=false
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
#
# Supabase Postgres connection string example:
# SUPABASE_DB_URL=postgresql://postgres.xxxxx:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Or use:
# DATABASE_URL=postgresql://...

# Required in production; choose unique administrator credentials.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# Remote PostgreSQL certificates are verified. Supply the provider CA if needed.
# PGSSL_CA=provider_ca_pem
# Explicitly list deployed web/admin/native origins; private-network auto-allow is development-only.
# ALLOWED_ORIGINS=https://your-app.example,https://your-admin.example,capacitor://localhost
